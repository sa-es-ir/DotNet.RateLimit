<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<AssemblyName>DotNet.RateLimiter.AzureFunctions</AssemblyName>
		<RootNamespace>DotNet.RateLimiter.Functions</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<Version>4.0.0</Version>
		<LangVersion>preview</LangVersion>
		<Authors>Saeed Esmaeelinejad</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageId>DotNetRateLimiter.AzureFunctions</PackageId>
		<PackageTags>azure-functions;isolated-worker;rate-limit</PackageTags>
		<PackageProjectUrl>https://github.com/sa-es-ir/DotNet.RateLimit</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/sa-es-ir/DotNet.RateLimit</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<Description>Azure Functions isolated worker middleware for DotNetRateLimiter: apply [RateLimit] to HttpTrigger functions</Description>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DotNet.RateLimiter.Test" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotNet.RateLimiter\DotNet.RateLimiter.csproj" />
	</ItemGroup>

</Project>
